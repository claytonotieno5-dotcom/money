# Generate a private key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
DATABASE_PATH=money_tracker.sqlite3

# console is for development only; verification codes are printed to the server log.
MAIL_MODE=console
# For email delivery, change MAIL_MODE to smtp and set the following values.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Moneyline <no-reply@example.com>

# Set COOKIE_SECURE=1 when served over HTTPS.
COOKIE_SECURE=0